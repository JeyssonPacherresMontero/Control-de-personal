# ==========================================================
# BASE DE DATOS MYSQL - XAMPP
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=control_personal
DB_USER=root
DB_PASS=

# ==========================================================
# ZKTeco
# ==========================================================
ZK_DEFAULT_TIMEOUT=8
ZK_CLEAR_ATTENDANCE_AFTER_SYNC=false
ZK_SYNC_USERS=true

# ==========================================================
# APLICACIÓN PHP
# ==========================================================
APP_NAME="Sistema de Control de Personal y Asistencia"
APP_ENV=production
APP_URL=http://localhost/control_personal
APP_TIMEZONE=America/Lima

# Evitar marcaciones duplicadas
ATTENDANCE_DEBOUNCE_MINUTES=3