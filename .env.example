# ==========================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA DE CONTROL DE PERSONAL
# ==========================================================

# Configuración Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=control_personal
DB_USER=root
DB_PASS=

# Configuración de Sincronización ZKTeco (Python)
ZK_DEFAULT_TIMEOUT=8
ZK_CLEAR_ATTENDANCE_AFTER_SYNC=false  # Cambiar a true solo si deseas vaciar la memoria del reloj tras descargar
ZK_SYNC_USERS=true                    # Descargar automáticamente nuevos usuarios creados en el reloj

# Configuración de la Aplicación PHP
APP_NAME="Sistema de Control de Personal y Asistencia"
APP_ENV=production
APP_URL=http://localhost/control_personal
APP_TIMEZONE="America/Lima"

# Debounce de marcación (minutos mínimos para evitar duplicados accidentales)
ATTENDANCE_DEBOUNCE_MINUTES=3
