# ==========================================================
# SISTEMA DE CONTROL DE PERSONAL Y ASISTENCIA - ZKTECO
# Plantilla de Configuración de Entorno (.env.example)
# ==========================================================
# Copiar este archivo a .env y ajustar los valores según el servidor:
#   cp .env.example .env

# ----------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS (MYSQL / MARIADB)
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=control_personal
DB_USER=control_user
DB_PASS=Cambiar_Esta_Contrasena_Segura_2026!

# ----------------------------------------------------------
# CONFIGURACIÓN DE RELOJES BIOMÉTRICOS ZKTECO
# ----------------------------------------------------------
ZK_DEFAULT_TIMEOUT=35
ZK_CLEAR_ATTENDANCE_AFTER_SYNC=false
ZK_SYNC_USERS=true

# Ruta al ejecutable de Python (Opcional - si se omite, PHP lo autodetectará)
# En Linux: /usr/bin/python3
# En Windows: C:/Python312/python.exe (Evitar apuntar a la ruta de ZKBioTime)
PYTHON_BIN=python

# ----------------------------------------------------------
# PARÁMETROS DE LA APLICACIÓN
# ----------------------------------------------------------
APP_NAME="JUSHSAL - Control de Personal y Asistencia"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080/control_personal
APP_TIMEZONE=America/Lima

# Timeout de inactividad de sesión en segundos (4 horas = 14400s)
SESSION_IDLE_TIMEOUT=14400

# Margen de tolerancia de debounce para evitar dobles marcaciones consecutivas (minutos)
ATTENDANCE_DEBOUNCE_MINUTES=3

# Clave criptográfica para plantillas biométricas (AES-256-GCM - 32 bytes en Hexadecimal)
# Generar una nueva clave para cada instalación con: php -r "echo bin2hex(random_bytes(32));"
BIOMETRIC_ENCRYPTION_KEY=b06b309d9506dbefcf272948e4bdc3a7681847c0f85b80e5932ed99fe9b0111a
